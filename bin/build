#!/usr/bin/env bash
# Build the single-file artifact at the repo root:
# src/tailwind.appdev.css with the @import line replaced by the contents
# of src/tailwind.theme.css, so apps load one stylesheet with no import
# waterfall.
#
# Pass --regenerate-theme to also rebuild src/tailwind.theme.css from the
# Tailwind version pinned in package.json (do this on Tailwind version bumps,
# and keep the <script src=".../@tailwindcss/browser@X.Y"> pin in app layouts
# on the same minor version).
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ "${1:-}" == "--regenerate-theme" ]]; then
  version=$(node -p "require('./package.json').devDependencies['@tailwindcss/cli']")
  echo '@import "tailwindcss/theme.css" theme(static);' \
    | npx -y @tailwindcss/cli@"$version" -i - -o src/tailwind.theme.css
  echo "regenerated src/tailwind.theme.css with @tailwindcss/cli@$version"
fi

{
  echo '/* GENERATED by bin/build — do not edit. Edit src/tailwind.appdev.css instead. */'
  awk '
    /@import url\("tailwind.theme.css"\);/ {
      while ((getline line < "src/tailwind.theme.css") > 0) print line
      close("src/tailwind.theme.css")
      next
    }
    { print }
  ' src/tailwind.appdev.css
} > tailwind.appdev.css

echo "built tailwind.appdev.css ($(wc -c < tailwind.appdev.css | tr -d ' ') bytes)"
